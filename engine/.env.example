# Copy to .env. Everything here is optional — Legend runs offline on BM25 + cited
# context. Configure a provider only if you want synthesized answers/explanations.

# Provider: openai | anthropic | groq | ollama | openrouter | custom   (blank = none)
LEGEND_LLM_PROVIDER=
LEGEND_LLM_MODEL=
LEGEND_LLM_BASE_URL=            # ollama: http://localhost:11434 ; or a custom endpoint

# API key — set the one matching your provider (Ollama needs none)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...            # Google AI Studio (free tier): https://aistudio.google.com

# Retrieval: auto | hybrid | bm25 | chroma   (auto/hybrid = BM25 + semantic fused via RRF)
LEGEND_EMBED_BACKEND=auto

# Disk cache (so relaunch doesn't re-parse/re-embed)
LEGEND_DATA_DIR=.legend_cache
LEGEND_USE_CACHE=1

# Optional: boot straight into your own repo
# LEGEND_REPO=C:/path/to/your/repo
