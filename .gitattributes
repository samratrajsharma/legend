# The repo is always LF. The working tree may be CRLF (Windows/editors/sync clients).
# Without this, a line-ending flip shows up as a whole-file diff and can be committed
# as one — which is how app.py picked up a 2891-line phantom diff.
* text=auto eol=lf

# Windows-only scripts stay CRLF on checkout
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.pkl  binary
*.bin  binary
