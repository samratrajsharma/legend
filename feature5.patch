+# ── explanation cache — repeat file/function explains are instant and free ──
+# Keyed by (kind, repo, path, [symbol], model, content-hash), so an edited file
+# or a changed model misses the cache and re-generates; identical repeats hit it.
+_EXPL_MEM: dict = {}
+
+
+def _expl_dir() -> Path:
+    d = Path(os.environ.get("KNOWIT_DATA_DIR", str(HERE / ".cache"))) / "explanations"
+    d.mkdir(parents=True, exist_ok=True)
+    return d
+
+
+def _sha(s: str) -> str:
+    return hashlib.sha1((s or "").encode("utf-8", "replace")).hexdigest()
+
+
+def _expl_key(*parts) -> str:
+    h = hashlib.sha1()
+    for p in parts:
+        h.update(str(p).encode("utf-8", "replace"))
+        h.update(b"\x00")
+    return h.hexdigest()
+
+
+def _expl_get(key: str):
+    if key in _EXPL_MEM:
+        return _EXPL_MEM[key]
+    try:
+        import json
+        f = _expl_dir() / f"{key}.json"
+        if f.exists():
+            txt = json.loads(f.read_text(encoding="utf-8")).get("text")
+            _EXPL_MEM[key] = txt
+            return txt
+    except Exception:
+        pass
+    return None
+
+
+def _expl_set(key: str, text: str, meta: dict = None):
+    _EXPL_MEM[key] = text
+    try:
+        import json
+        import time
+        (_expl_dir() / f"{key}.json").write_text(
+            json.dumps({"text": text, "at": time.time(), **(meta or {})}, ensure_ascii=False),
+            encoding="utf-8")
+    except Exception:
+        pass
+
+
