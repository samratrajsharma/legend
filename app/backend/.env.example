# Copy to .env and fill in (optional — testbed runs without any keys)

# LLM provider for Q&A answers. Leave empty to run context-only.
LEGEND_LLM_PROVIDER=
LEGEND_LLM_MODEL=
LEGEND_LLM_BASE_URL=

# Provider API keys (only set the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Where the engine caches parsed indexes (relative to this backend folder)
LEGEND_DATA_DIR=./.cache
